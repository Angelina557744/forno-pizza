<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <%- include('partials/layout-head', { title: 'Заказ ' + order.order_number, active: 'orders' }) %>

  <a href="/admin/orders" class="admin-back">← Все заказы</a>

  <div class="admin-order-grid">

    <div class="admin-card">
      <h2 class="admin-card__title">Данные клиента</h2>
      <div class="admin-rows">
        <div class="admin-row"><span>Имя</span><strong><%= order.customer_name %></strong></div>
        <div class="admin-row"><span>Телефон</span><strong><%= order.customer_phone %></strong></div>
        <div class="admin-row"><span>Email</span><strong><%= order.customer_email || '—' %></strong></div>
        <div class="admin-row"><span>Способ</span><strong><%= order.delivery_type === 'delivery' ? 'Доставка' : 'Самовывоз' %></strong></div>
        <% if (order.address) { %>
          <div class="admin-row"><span>Адрес</span><strong><%= order.address %></strong></div>
        <% } %>
        <div class="admin-row"><span>Оплата</span><strong><%= order.payment_method === 'online' ? 'Картой онлайн' : 'При получении' %></strong></div>
        <div class="admin-row"><span>Комментарий</span><strong><%= order.comment || '—' %></strong></div>
        <div class="admin-row"><span>Дата</span><strong><%= order.created_at %></strong></div>
      </div>
    </div>

    <div class="admin-card">
      <h2 class="admin-card__title">Состав заказа</h2>
      <div class="admin-order-items">
        <% items.forEach(function(item) { %>
          <div class="admin-order-item">
            <div>
              <div class="admin-order-item__name"><%= item.dish_name %></div>
              <% if (item.size || item.dough || item.toppings) { %>
                <div class="admin-order-item__meta">
                  <% if (item.size) { %><span><%= item.size %> см</span><% } %>
                  <% if (item.dough) { %><span><%= item.dough %></span><% } %>
                  <% if (item.toppings) { %><span><%= item.toppings %></span><% } %>
                </div>
              <% } %>
            </div>
            <div class="admin-order-item__qty">× <%= item.quantity %></div>
            <div class="admin-order-item__price"><%= item.price * item.quantity %> ₽</div>
          </div>
        <% }); %>
      </div>
      <div class="admin-order-total">
        <span>Итого</span>
        <strong><%= order.total %> ₽</strong>
      </div>
    </div>

    <div class="admin-card">
      <h2 class="admin-card__title">Статус заказа</h2>
      <form method="POST" action="/admin/orders/<%= order.id %>/status" class="admin-status-form">
        <label class="admin-radio">
          <input type="radio" name="status" value="new" <%= order.status === 'new' ? 'checked' : '' %>>
          <span>Новый</span>
        </label>
        <label class="admin-radio">
          <input type="radio" name="status" value="processing" <%= order.status === 'processing' ? 'checked' : '' %>>
          <span>В работе</span>
        </label>
        <label class="admin-radio">
          <input type="radio" name="status" value="delivered" <%= order.status === 'delivered' ? 'checked' : '' %>>
          <span>Доставлен</span>
        </label>
        <label class="admin-radio">
          <input type="radio" name="status" value="cancelled" <%= order.status === 'cancelled' ? 'checked' : '' %>>
          <span>Отменён</span>
        </label>
        <button class="btn btn--solid btn--full" type="submit">Сохранить статус</button>
      </form>
    </div>

  </div>

  <%- include('partials/layout-foot') %>
</body>
</html>