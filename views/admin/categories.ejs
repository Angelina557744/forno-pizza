<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <%- include('partials/layout-head', { title: 'Категории', active: 'categories' }) %>

  <div class="admin-table">
    <div class="admin-table__head admin-table__head--categories">
      <span>Порядок</span>
      <span>Название</span>
      <span>Slug</span>
    </div>
    <% categories.forEach(function(c) { %>
      <div class="admin-table__row admin-table__row--categories">
        <span class="admin-table__mono"><%= c.sort_order %></span>
        <span><%= c.name %></span>
        <span class="admin-table__mono"><%= c.slug %></span>
      </div>
    <% }); %>
  </div>

  <%- include('partials/layout-foot') %>
</body>
</html>