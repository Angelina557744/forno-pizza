<header class="header">
  <div class="header__inner">
    <a href="/" class="logo" aria-label="Forno">
      <svg class="logo__icon" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M20 4c-6 0-11 5-11 11 0 4 2 7 4 9 1 1 2 2 2 4v6h10v-6c0-2 1-3 2-4 2-2 4-5 4-9 0-6-5-11-11-11z" stroke="currentColor" stroke-width="1.5"/>
        <path d="M15 22h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M17 27h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="logo__text">Forno</span>
    </a>

    <nav class="nav" aria-label="Основная навигация">
      <a href="/menu" class="nav__link">Меню</a>
      <a href="/delivery" class="nav__link">Доставка</a>
      <a href="/booking" class="nav__link">Бронь</a>
      <a href="/about" class="nav__link">О нас</a>
      <a href="/contacts" class="nav__link">Контакты</a>
    </nav>

    <div class="header__actions">
      <a href="tel:+74951234567" class="header__phone">+7 495 123 45 67</a>
      <button class="cart-btn" type="button" aria-label="Корзина" data-cart-open>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 6h2l2 12h12l2-9H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9" cy="20" r="1.5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="18" cy="20" r="1.5" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span class="cart-btn__count" data-cart-count><%= cartCount %></span>
      </button>
      <button class="burger" type="button" aria-label="Меню" data-burger>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav>
    <nav class="mobile-nav__inner">
      <a href="/menu">Меню</a>
      <a href="/delivery">Доставка</a>
      <a href="/booking">Бронь</a>
      <a href="/about">О нас</a>
      <a href="/contacts">Контакты</a>
      <a href="tel:+74951234567" class="mobile-nav__phone">+7 495 123 45 67</a>
    </nav>
  </div>
</header>