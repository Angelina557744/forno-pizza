<aside class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__head">
      <h2 class="cart-drawer__title">Корзина</h2>
      <button class="cart-drawer__close" type="button" data-cart-close aria-label="Закрыть">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="cart-drawer__body" data-cart-body>
      <% if (cart.length === 0) { %>
        <div class="cart-empty">
          <svg viewBox="0 0 60 60" fill="none" aria-hidden="true">
            <circle cx="30" cy="30" r="24" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 4"/>
            <path d="M20 30h20M30 20v20" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          <p>Корзина пока пуста</p>
          <a href="/menu" class="btn btn--ghost">Перейти в меню</a>
        </div>
      <% } else { %>
        <% cart.forEach(function(item) { %>
          <div class="cart-item" data-cart-item="<%= item.key %>">
            <div class="cart-item__body">
              <div class="cart-item__name"><%= item.name %></div>
              <% if (item.size || item.dough || (item.toppings && item.toppings.length)) { %>
                <div class="cart-item__meta">
                  <% if (item.size) { %><span><%= item.size %> см</span><% } %>
                  <% if (item.dough) { %><span><%= item.dough %></span><% } %>
                  <% if (item.toppings && item.toppings.length) { %><span>+ <%= item.toppings.length %></span><% } %>
                </div>
              <% } %>
              <div class="cart-item__price"><%= item.price * item.quantity %> ₽</div>
            </div>
            <div class="cart-item__qty">
              <button type="button" data-cart-dec>−</button>
              <span data-cart-qty><%= item.quantity %></span>
              <button type="button" data-cart-inc>+</button>
            </div>
            <button class="cart-item__remove" type="button" data-cart-remove aria-label="Удалить">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>
    </div>

    <div class="cart-drawer__foot">
      <div class="cart-drawer__total">
        <span>Итого</span>
        <strong data-cart-total><%= cartTotal %> ₽</strong>
      </div>
      <a href="/checkout" class="btn btn--solid btn--full">Оформить заказ</a>
      <a href="/cart" class="cart-drawer__link">Перейти в корзину</a>
    </div>
  </div>
</aside>